  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://app.verityaml.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://app.verityaml.com/signup"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/verity-aml"
    }
