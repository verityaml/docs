{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Verity",
  "colors": {
    "primary": "#2A382E",
    "light": "#2A382E",
    "dark": "#F2F0EB"
  },
  "font": {
