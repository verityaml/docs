        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "walkthrough"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/dashboard",
              "features/scoring",
              "features/library",
              "features/examinations",
              "features/evidence",
              "features/evidence-linking",
              "features/archive"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "developers/quickstart",
              "developers/docker"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "developers/architecture",
              "developers/data-model",
              "developers/background-jobs"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              "developers/conventions",
              "developers/testing",
              "developers/roadmap"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Examinations",
            "pages": [
              "api-reference/examinations"
            ]
          },
          {
            "group": "Compliance programs",
            "pages": [
              "api-reference/compliance-programs"
            ]
          },
          {
            "group": "Knowledge base",
            "pages": [
              "api-reference/knowledge-base"
            ]
          },
          {
            "group": "MRAs",
            "pages": [
              "api-reference/mras"
            ]
          },
          {
            "group": "Evidence links",
            "pages": [
              "api-reference/evidence-links"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "api-reference/organization"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://app.verityaml.com",
          "icon": "browser"
        },
        {
